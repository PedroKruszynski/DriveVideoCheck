{
  "manifest_version": 3,
  "name": "Drive Video Check",
  "version": "1.0.0",
  "description": "Add a new option Google Drive.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://drive.google.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
